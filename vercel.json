{
  "buildCommand": "pnpm --filter @workspace/roman-academy run build",
  "outputDirectory": "artifacts/roman-academy/dist/public",
  "installCommand": "pnpm install",
  {
    "framework": "vite",
    "outputDirectory": "artifacts/roman-academy/dist/public"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://roman-academy-api.onrender.com/api/:path*"
    }
  ]
}
